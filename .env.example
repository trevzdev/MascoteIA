# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE SEGURA (Google OAuth 2.0 & APIs)
# ==============================================================================
# IMPORTANTE: Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA comite o arquivo ".env" no controle de versão (Git)!
# ==============================================================================

# Modo de execução do Flask: 'development' ou 'production'
FLASK_ENV=development

# Chave secreta da sessão do Flask (Gere uma chave forte de 32+ bytes em produção)
# Exemplo de geração: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cole_aqui_uma_chave_aleatoria_longa_e_secreta

# Chave de criptografia Fernet para criptografar tokens salvos em sessão
# Exemplo de geração: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=

# URL Base da aplicação (Para desenvolvimento local use http://localhost:5000 ou http://127.0.0.1:5000)
# No Google Cloud Console, a URI de redirecionamento autorizada deve ser:
# http://localhost:5000/auth/callback
BASE_URL=http://localhost:5000

# Porta do servidor Flask
PORT=5000

# Apenas para desenvolvimento local HTTP (Permite OAuth via HTTP ao invés de HTTPS)
# Em PRODUÇÃO, defina como 0 ou remova para forçar HTTPS obrigatório!
OAUTHLIB_INSECURE_TRANSPORT=1

# ==============================================================================
# CREDENCIAIS GOOGLE OAUTH 2.0
# Obtenha no Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# ==============================================================================
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# ==============================================================================
# CHAVE GEMINI PRO / GOOGLE AI STUDIO (Opcional se usar apenas Calendar/Drive)
# Obtenha em: https://aistudio.google.com/app/apikey
# Utilize a chave da sua cota/faturamento Pro para altas taxas de requisição.
# ==============================================================================
GEMINI_API_KEY=sua_chave_gemini_pro_aqui
GEMINI_MODEL=gemini-2.5-pro

